#!/bin/bash
# يُنفَّذ مرة عند إقلاع نظام الحياة: يولّد اللغات وينشئ مستخدم zool (بدون كلمة مرور)
set -e
locale-gen >/dev/null 2>&1 || true
if ! id zool >/dev/null 2>&1; then
    useradd -m -G wheel,audio,video,input,storage,optical,network -s /bin/bash -c "Zool" zool
    passwd -d zool >/dev/null
fi
install -d -o zool -g zool /home/zool/Pictures /home/zool/Downloads /home/zool/Documents
