#!/bin/sh
# قائمة زول — SUPER+Z : كل شيء من مكان واحد
LIVE=""; [ -d /run/archiso ] && LIVE="تثبيت زول على القرص"
choice=$(printf '%s\n' \
  "التطبيقات" \
  "الملفات" \
  "المتصفح" \
  "الإعدادات" \
  "الثيم والألوان" \
  "الخلفية" \
  "متجر البرامج" \
  "تحديث النظام" \
  ${LIVE:+"$LIVE"} \
  "الاختصارات" \
  "مراقب النظام" \
  "شاشة الترحيب" \
  "الطاقة" \
  | wofi --dmenu --prompt "زول" --width 460 --height 560 --columns 1) || exit 0

case "$choice" in
    التطبيقات)  wofi --show drun ;;
    الملفات)    thunar ;;
    المتصفح)    firefox ;;
    الإعدادات)  zool-settings ;;
    الثيم*)     zool-theme ;;
    الخلفية)    zool-wallpaper pick ;;
    متجر*)      zool-store ;;
    تحديث*)     kitty --title "تحديث زول" -e zool-update ;;
    تثبيت*)     zool-install ;;
    الاختصارات) zool-keys ;;
    مراقب*)     kitty -e btop ;;
    شاشة*)      zool-welcome ;;
    الطاقة)     zool-power ;;
esac
