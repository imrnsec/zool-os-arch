#!/bin/bash
# zool-sublime-setup — يثبّت Sublime Text من مستودعه الرسمي ويجعله محرر النصوص الافتراضي.
#   sudo zool-sublime-setup                 تحديث كامل للنظام ثم التثبيت (كما توصي به Sublime)
#   sudo zool-sublime-setup --after-upgrade يُستدعى من zool-update بعد أن حدّث النظام للتو
# يتبع تعليمات Arch الرسمية: https://www.sublimetext.com/docs/linux_repositories.html
# Sublime Text برنامج مغلق المصدر (تجربة مجانية بلا انتهاء، والترخيص للاستعمال الدائم)، ولذلك لا نضمّه في ملف ISO بل نحمّله من موقعه.
set -u
[ "$(id -u)" = 0 ] || { echo "يحتاج root:  sudo zool-sublime-setup" >&2; exit 1; }
STATE=/var/lib/zool
KEY_URL=https://download.sublimetext.com/sublimehq-pub.gpg
KEY_ID=8A8F901A
case "$(uname -m)" in
    x86_64)  ARCH=x86_64 ;;
    aarch64) ARCH=aarch64 ;;
    *) echo "معمارية غير مدعومة من Sublime: $(uname -m)" >&2; exit 5 ;;
esac
REPO_URL=https://download.sublimetext.com/arch/stable/$ARCH
DESKTOP=sublime_text.desktop

if ! pacman -Qq sublime-text >/dev/null 2>&1; then
    curl -fsI --max-time 20 "$KEY_URL" >/dev/null 2>&1 || { echo "لا يوجد اتصال بموقع Sublime — تأكد من الإنترنت وأعد المحاولة." >&2; exit 2; }

    if ! pacman-key --list-keys "$KEY_ID" >/dev/null 2>&1; then
        tmp=$(mktemp) && curl -fsSL --max-time 60 "$KEY_URL" -o "$tmp" \
            && pacman-key --add "$tmp" && pacman-key --lsign-key "$KEY_ID" || { rm -f "$tmp"; echo "فشل استيراد مفتاح Sublime" >&2; exit 3; }
        rm -f "$tmp"
    fi
    # كتلة واحدة صحيحة فقط: نحذف أي كتل [sublime-text] قديمة أو مكرّرة (قد تكون بمعمارية خاطئة) ثم نكتبها من جديد
    cur=$(awk '/^\[sublime-text\]/{k=1;next} /^\[/{k=0} k&&/^Server/{print $3}' /etc/pacman.conf | tr '\n' ' ')
    if [ "$cur" != "$REPO_URL " ]; then
        tmpc=$(mktemp)
        awk '/^\[sublime-text\]/{skip=1;next} /^\[/{skip=0} !skip' /etc/pacman.conf > "$tmpc" \
            && printf '\n[sublime-text]\nServer = %s\n' "$REPO_URL" >> "$tmpc" && cat "$tmpc" > /etc/pacman.conf
        rm -f "$tmpc"
    fi

    if [ "${1:-}" = "--after-upgrade" ]; then flags=-Sy; else flags=-Syu; fi
    pacman "$flags" --needed --noconfirm sublime-text || { echo "فشل تثبيت sublime-text" >&2; exit 4; }
fi

# ── المحرر الافتراضي لملفات النص والبرمجة (دون مسّ من اختار محرراً آخر بنفسه) ──
[ -f "/usr/share/applications/$DESKTOP" ] || DESKTOP=$(cd /usr/share/applications && ls sublime*text*.desktop 2>/dev/null | head -1)
if [ -n "$DESKTOP" ]; then
    MIMES="text/plain text/markdown text/x-python text/x-shellscript application/x-shellscript application/json application/xml text/xml text/css text/javascript application/javascript text/x-csrc text/x-chdr text/x-c++src text/x-java text/x-log text/csv text/x-makefile application/x-yaml text/x-lua application/toml"
    set_default() {   # $1=ملف mimeapps
        local f=$1 m cur tmp
        [ -f "$f" ] || return 0
        tmp=$(mktemp)
        cp "$f" "$tmp"
        grep -q '^\[Default Applications\]' "$tmp" || printf '[Default Applications]\n' >> "$tmp"
        for m in $MIMES; do
            cur=$(grep -m1 -F "$m=" "$tmp" | sed -n "s|^$m=||p")
            case "$cur" in ""|*mousepad*) ;; *) continue ;; esac      # اختار المستخدم محرراً آخر ← نتركه
            sed -i "\|^$m=|d" "$tmp"
            sed -i "\|^\[Default Applications\]|a $m=$DESKTOP" "$tmp"
        done
        cat "$tmp" > "$f"; rm -f "$tmp"        # cat > يحفظ مالك الملف وصلاحياته
    }
    set_default /etc/skel/.config/mimeapps.list
    for h in /home/*; do [ -d "$h/.config" ] && set_default "$h/.config/mimeapps.list"; done
    # للمستخدمين الذين ليس لديهم ملف mimeapps: نكتب الافتراضي على مستوى النظام
    mkdir -p /etc/xdg
    [ -f /etc/xdg/mimeapps.list ] || printf '[Default Applications]\n%s\n' "text/plain=$DESKTOP" > /etc/xdg/mimeapps.list
fi

mkdir -p "$STATE"; touch "$STATE/sublime-done"
echo "✓ Sublime Text جاهز — محرر النصوص الافتراضي في زول (الأمر: subl)"
