#!/bin/sh
# عرض الاختصارات — SUPER+F1
printf '%s\n' \
  "SUPER + Enter        الطرفية (kitty)" \
  "SUPER + Space        قائمة التطبيقات" \
  "SUPER + Z            قائمة زول (إعدادات وأدوات)" \
  "SUPER + B            المتصفح" \
  "SUPER + E            مدير الملفات" \
  "SUPER + W            إغلاق النافذة" \
  "SUPER + F            ملء الشاشة" \
  "SUPER + V            نافذة عائمة / مثبّتة" \
  "SUPER + J            تبديل اتجاه التقسيم" \
  "SUPER + 1..9         مساحة العمل" \
  "SUPER+SHIFT + 1..9   نقل النافذة لمساحة عمل" \
  "SUPER + الأسهم       التنقل بين النوافذ" \
  "SUPER + C            سجل الحافظة" \
  "SUPER+SHIFT + W      تغيير الخلفية" \
  "SUPER + L            قفل الشاشة" \
  "SUPER + Esc          قائمة الطاقة" \
  "Print                لقطة لمنطقة (تُنسخ وتُحفظ)" \
  "SHIFT + Print        لقطة للشاشة كاملة" \
  "ALT + SHIFT          تبديل اللغة (EN / عربي)" \
  "SUPER+SHIFT + M      الخروج من Hyprland" \
  | wofi --dmenu --prompt "الاختصارات" --width 620 --height 620 --columns 1 >/dev/null
