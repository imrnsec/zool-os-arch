#!/usr/bin/env python3
# ═══════════════════════════════════════════════
#  Zool Terminal — طرفية زول
#  مبنية على محرّك VTE: العربية تظهر متصلة ومن اليمين لليسار، والأوامر الإنجليزية من اليسار.
#
#    zool-terminal                      طرفية جديدة (بصدفتك الافتراضية)
#    zool-terminal -e أمر [وسائط…]      تشغيل أمر داخلها
#    zool-terminal --title عنوان …      عنوان النافذة
#
#  Ctrl+Shift+T لسان جديد · Ctrl+Shift+W إغلاق اللسان · Ctrl+PageUp/PageDown التنقل بين الألسنة
#  Ctrl+Shift+C/V نسخ/لصق · Ctrl + و Ctrl - و Ctrl 0 حجم الخط · Ctrl+Shift+D اتجاه الفقرة
#  الألوان تتبع الثيم الحالي (zool-theme) وتتغير مباشرة عند تبديله.
# ═══════════════════════════════════════════════
import os
import pwd
import shutil
import sys

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
COLORS_FILE = os.path.join(CFG, "zool", "theme", "kitty.conf")      # يكتبه zool-theme
LANG_FILE = os.path.join(CFG, "zool", "lang")
FONT = "JetBrainsMono Nerd Font 11"
ICON = "/usr/share/zool/logo/zool-logo-128.png"

DEFAULTS = {
    "foreground": "#f3e6cc", "background": "#10181c", "cursor": "#e8b04a",
    "color0": "#172229", "color1": "#d46a43", "color2": "#8fb35f", "color3": "#e8b04a",
    "color4": "#2d86b4", "color5": "#c58bb0", "color6": "#3ba5a0", "color7": "#f3e6cc",
    "color8": "#b9a98a", "color9": "#d46a43", "color10": "#8fb35f", "color11": "#e8b04a",
    "color12": "#2d86b4", "color13": "#c58bb0", "color14": "#3ba5a0", "color15": "#ffffff",
}


def parse_args(argv):
    title, cmd, i = None, [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--title" and i + 1 < len(argv):
            title = argv[i + 1]; i += 2
        elif a in ("--class", "--name") and i + 1 < len(argv):
            i += 2                                            # للتوافق مع أوامر kitty القديمة
        elif a == "-e":
            cmd = argv[i + 1:]; break
        elif a in ("-h", "--help"):
            print(__doc__ or "zool-terminal [--title T] [-e cmd …]"); sys.exit(0)
        else:
            cmd = argv[i:]; break
    return title, cmd


def read_colors():
    c = dict(DEFAULTS)
    try:
        with open(COLORS_FILE, encoding="utf-8") as f:
            for line in f:
                p = line.split()
                if len(p) == 2 and p[0] in c and p[1].startswith("#") and len(p[1]) == 7:
                    c[p[0]] = p[1]
    except OSError:
        pass
    return c


def user_shell():
    sh = os.environ.get("SHELL")
    if not sh or not os.path.exists(sh):
        try:
            sh = pwd.getpwuid(os.getuid()).pw_shell
        except KeyError:
            sh = None
    for cand in (sh, "/bin/zsh", "/bin/bash", "/bin/sh"):
        if cand and os.path.exists(cand):
            return cand
    return "/bin/sh"


def fallback(title, cmd):
    """إن تعذر تحميل GTK/VTE نفتح أي طرفية أخرى موجودة حتى لا يبقى المستخدم بلا طرفية."""
    for t, pre in (("kitty", ["--title", title or "Zool"]), ("lxterminal", []), ("foot", []), ("xterm", [])):
        path = shutil.which(t)
        if path:
            args = [path] + pre + (["-e"] + cmd if cmd else [])
            os.execv(path, args)
    sys.stderr.write("zool-terminal: لا توجد مكتبة VTE ولا طرفية بديلة.\n")
    sys.exit(1)


TITLE, CMD = parse_args(sys.argv[1:])
if __name__ == "__main__" and os.environ.get("ZOOL_TERMINAL_SELFTEST"):
    print(TITLE, CMD, user_shell(), read_colors()["background"]); sys.exit(0)

try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Vte", "2.91")
    from gi.repository import Gdk, Gio, GLib, Gtk, Pango, Vte
except Exception as exc:                                       # noqa: BLE001
    sys.stderr.write(f"zool-terminal: {exc}\n")
    fallback(TITLE, CMD)

try:
    AR = open(LANG_FILE, encoding="utf-8").read().strip() != "en"
except OSError:
    AR = True


def T(ar, en):
    return ar if AR else en


def rgba(hex_):
    c = Gdk.RGBA(); c.parse(hex_); return c


class ZoolTerminal(Gtk.Window):
    def __init__(self):
        super().__init__(title=TITLE or T("طرفية زول", "Zool Terminal"))
        self.set_default_size(920, 560)
        if os.path.exists(ICON):
            try:
                self.set_icon_from_file(ICON)
            except GLib.Error:
                pass
        self.scale = 1.0
        self.dir_mode = 0                                      # 0 تلقائي · 1 يمين · 2 يسار
        self.nb = Gtk.Notebook()
        self.nb.set_scrollable(True); self.nb.set_show_border(False); self.nb.set_show_tabs(False)
        self.add(self.nb)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        css = Gtk.CssProvider()
        css.load_from_data(b"vte-terminal { padding: 10px 12px; } notebook tab { padding: 4px 12px; }")
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # تغيّر الثيم ← نعيد تلوين كل الألسنة فوراً
        try:
            os.makedirs(os.path.dirname(COLORS_FILE), exist_ok=True)
            self.mon = Gio.File.new_for_path(os.path.dirname(COLORS_FILE)).monitor_directory(Gio.FileMonitorFlags.NONE, None)
            self.mon.connect("changed", lambda *a: GLib.timeout_add(250, self.recolor))
        except (GLib.Error, OSError):
            self.mon = None
        self.new_tab(CMD)

    # ── الألسنة ──
    def terms(self):
        return [self.nb.get_nth_page(i) for i in range(self.nb.get_n_pages())]

    def current(self):
        return self.nb.get_nth_page(self.nb.get_current_page())

    def new_tab(self, cmd=None):
        t = Vte.Terminal()
        t.set_scrollback_lines(10000)
        t.set_mouse_autohide(True)
        t.set_allow_hyperlink(True)
        t.set_audible_bell(False)
        t.set_cursor_blink_mode(Vte.CursorBlinkMode.ON)
        for name in ("set_enable_bidi", "set_enable_shaping"):     # دعم العربية: الاتجاه وتشكيل الحروف
            if hasattr(t, name):
                getattr(t, name)(True)
        t.set_font(Pango.FontDescription.from_string(FONT))
        t.set_font_scale(self.scale)
        self.apply_colors(t)
        t.connect("child-exited", self.on_exit)
        t.connect("button-press-event", self.on_button)
        t.connect("window-title-changed", self.on_title)
        label = Gtk.Label(label=T("طرفية", "Terminal"))
        self.nb.append_page(t, label)
        self.nb.set_tab_reorderable(t, True)
        argv = list(cmd) if cmd else [user_shell()]
        cwd = HOME
        cur = self.current() if self.nb.get_n_pages() > 1 else None
        if cur is not None and not cmd:
            uri = cur.get_current_directory_uri()
            if uri and uri.startswith("file://"):
                cwd = GLib.filename_from_uri(uri)[0]
        env = dict(os.environ, TERM="xterm-256color", COLORTERM="truecolor", TERM_PROGRAM="zool-terminal")
        t.spawn_async(Vte.PtyFlags.DEFAULT, cwd, argv, [f"{k}={v}" for k, v in env.items()],
                      GLib.SpawnFlags.SEARCH_PATH, None, None, -1, None, self.on_spawn, argv)
        self.show_all()
        self.nb.set_current_page(self.nb.page_num(t))
        self.nb.set_show_tabs(self.nb.get_n_pages() > 1)
        t.grab_focus()

    def on_spawn(self, term, pid, error, argv):
        if error is not None or pid == -1:
            msg = T("تعذر تشغيل: ", "Could not run: ") + " ".join(argv) + (f"\r\n{error.message}" if error else "")
            term.feed((msg + "\r\n").encode())

    def close_tab(self, t):
        n = self.nb.page_num(t)
        if n >= 0:
            self.nb.remove_page(n)
        if self.nb.get_n_pages() == 0:
            self.destroy()
        else:
            self.nb.set_show_tabs(self.nb.get_n_pages() > 1)
            self.current().grab_focus()

    def on_exit(self, t, status):
        self.close_tab(t)

    def on_title(self, t):
        title = t.get_window_title() or T("طرفية", "Terminal")
        self.nb.set_tab_label_text(t, title[-28:])
        if t is self.current() and not TITLE:
            self.set_title(title)

    # ── المظهر ──
    def apply_colors(self, t):
        c = read_colors()
        t.set_colors(rgba(c["foreground"]), rgba(c["background"]), [rgba(c[f"color{i}"]) for i in range(16)])
        t.set_color_cursor(rgba(c["cursor"]))
        t.set_color_cursor_foreground(rgba(c["background"]))

    def recolor(self):
        for t in self.terms():
            self.apply_colors(t)
        return False

    def zoom(self, factor):
        self.scale = 1.0 if factor is None else max(0.5, min(3.0, self.scale * factor))
        for t in self.terms():
            t.set_font_scale(self.scale)

    def toggle_direction(self, *_):
        """اتجاه الفقرات: تلقائي ← من اليمين ← من اليسار (تسلسلات BiDi القياسية للطرفيات)."""
        self.dir_mode = (self.dir_mode + 1) % 3
        seq = (b"\x1b[?2501h\x1b[0 k", b"\x1b[?2501l\x1b[2 k", b"\x1b[?2501l\x1b[1 k")[self.dir_mode]
        t = self.current()
        if t is not None:
            t.feed(seq)

    # ── الإدخال ──
    def on_key(self, _w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        shift = ev.state & Gdk.ModifierType.SHIFT_MASK
        k = Gdk.keyval_name(ev.keyval) or ""
        t = self.current()
        if not ctrl or t is None:
            return False
        if shift:
            kl = k.lower()
            if kl == "c": t.copy_clipboard_format(Vte.Format.TEXT); return True
            if kl == "v": t.paste_clipboard(); return True
            if kl == "t": self.new_tab(); return True
            if kl == "w": self.close_tab(t); return True
            if kl == "d": self.toggle_direction(); return True
        if k in ("plus", "equal", "KP_Add"): self.zoom(1.1); return True
        if k in ("minus", "KP_Subtract"): self.zoom(1 / 1.1); return True
        if k in ("0", "KP_0"): self.zoom(None); return True
        if k == "Page_Up": self.nb.prev_page(); return True
        if k == "Page_Down": self.nb.next_page(); return True
        return False

    def on_button(self, t, ev):
        if ev.button != 3:
            return False
        m = Gtk.Menu()
        for text, fn in (
            (T("نسخ", "Copy"), lambda *_: t.copy_clipboard_format(Vte.Format.TEXT)),
            (T("لصق", "Paste"), lambda *_: t.paste_clipboard()),
            (None, None),
            (T("لسان جديد", "New tab"), lambda *_: self.new_tab()),
            (T("إغلاق اللسان", "Close tab"), lambda *_: self.close_tab(t)),
            (None, None),
            (T("تكبير الخط", "Zoom in"), lambda *_: self.zoom(1.1)),
            (T("تصغير الخط", "Zoom out"), lambda *_: self.zoom(1 / 1.1)),
            (T("اتجاه الفقرة: تلقائي ← يمين ← يسار", "Paragraph direction: auto → RTL → LTR"), self.toggle_direction),
        ):
            if text is None:
                m.append(Gtk.SeparatorMenuItem()); continue
            it = Gtk.MenuItem(label=text); it.connect("activate", fn); m.append(it)
        m.show_all()
        m.popup_at_pointer(ev)
        return True


if __name__ == "__main__":
    GLib.set_prgname("zool-terminal")                          # معرّف النافذة (للأيقونة في شريط المهام)
    GLib.set_application_name("Zool Terminal")
    ZoolTerminal()
    Gtk.main()
