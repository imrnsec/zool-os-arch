#!/bin/sh
# مؤشر الصوت والسطوع على الشاشة (عبر إشعار mako بشريط تقدّم — بلا برامج إضافية)
#   zool-osd volume up|down|mute      zool-osd mic mute      zool-osd brightness up|down
STEP=5
show() {  # show <العنوان> <النسبة> [نص]
    notify-send -a zool-osd -t 1200 \
        -h string:x-canonical-private-synchronous:zool-osd \
        -h "int:value:$2" "$1" "${3:-$2%}" 2>/dev/null
}

case "$1 $2" in
    "volume up")    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ ${STEP}%+ ;;
    "volume down")  wpctl set-volume @DEFAULT_AUDIO_SINK@ ${STEP}%- ;;
    "volume mute")  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    "mic mute")     wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    "brightness up")   brightnessctl -q set ${STEP}%+ ;;
    "brightness down") brightnessctl -q set ${STEP}%- ;;   # لا ينزل تحت 1% حتى لا تسودّ الشاشة
    *) echo "الاستخدام: zool-osd volume up|down|mute | mic mute | brightness up|down" >&2; exit 2 ;;
esac

case "$1" in
    volume)
        out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)          # مثال: Volume: 0.40 [MUTED]
        pct=$(printf '%s\n' "$out" | awk '{printf "%d", $2*100+0.5}')
        case "$out" in *MUTED*) show "الصوت" 0 "مكتوم" ;; *) show "الصوت" "${pct:-0}" ;; esac ;;
    mic)
        out=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
        case "$out" in *MUTED*) show "الميكروفون" 0 "مكتوم" ;; *) show "الميكروفون" 100 "يعمل" ;; esac ;;
    brightness)
        pct=$(brightnessctl -m 2>/dev/null | awk -F, '{gsub("%","",$4); print $4}')
        [ "${pct:-0}" -lt 1 ] 2>/dev/null && { brightnessctl -q set 1%; pct=1; }
        show "السطوع" "${pct:-0}" ;;
esac
exit 0
