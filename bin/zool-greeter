#!/usr/bin/env python3
"""شاشة دخول زول — تصميم مقسّم (يسار: صورة، يمين: لوحة دخول).
تتحدث مع greetd عبر المقبس $GREETD_SOCK ثم تبدأ جلسة Hyprland.
"""
import glob
import json
import os
import pwd
import socket
import struct
import subprocess
import sys

SESSION_CMD = ["/usr/local/bin/zool-session"]
SESSION_ENV = ["XDG_SESSION_TYPE=wayland", "XDG_CURRENT_DESKTOP=Hyprland"]
LAST_USER = "/var/lib/zool-greeter/last-user"


def find_bg():
    """يجلب أول خلفية متاحة من الثيمات المثبّتة (أبجدياً)."""
    for pat in [
        "/usr/share/zool/themes/khartoum/backgrounds/*.jpg",
        "/usr/share/zool/themes/turath/backgrounds/*.jpg",
        "/usr/share/zool/themes/*/backgrounds/*.jpg",
    ]:
        files = sorted(glob.glob(pat))
        if files:
            return files[0]
    return ""


BG = find_bg()


# ── بروتوكول greetd ──────────────────────────────────────────────────────────

class Greetd:
    """greetd: طول الرسالة (u32 native-endian) ثم JSON."""

    def __init__(self, path=None):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.connect(path or os.environ["GREETD_SOCK"])

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            part = self.s.recv(n - len(buf))
            if not part:
                raise ConnectionError("greetd closed the connection")
            buf += part
        return buf

    def call(self, **msg):
        data = json.dumps(msg).encode()
        self.s.sendall(struct.pack("=I", len(data)) + data)
        (n,) = struct.unpack("=I", self._read(4))
        return json.loads(self._read(n).decode())

    def login(self, user, password):
        """يعيد (True, "") عند النجاح، أو (False, سبب)."""
        print(f"[zool-greeter] create_session username={user!r}", file=sys.stderr)
        r = self.call(type="create_session", username=user)
        for _ in range(8):
            if r.get("type") != "auth_message":
                break
            kind = r.get("auth_message_type")
            r = self.call(type="post_auth_message_response",
                          response=password if kind in ("secret", "visible") else None)
        if r.get("type") == "success":
            r = self.call(type="start_session", cmd=SESSION_CMD, env=SESSION_ENV)
            if r.get("type") == "success":
                return True, ""
            return False, r.get("description", "start_session failed")
        print(f"[zool-greeter] auth failed for {user!r}: {r!r}", file=sys.stderr)
        try:
            self.call(type="cancel_session")
        except (OSError, ValueError):
            pass
        return False, "auth" if r.get("error_type") == "auth_error" else r.get("description", "error")


# ── مساعدات ──────────────────────────────────────────────────────────────────

def has_arabic(text):
    return any("؀" <= ch <= "ۿ" or "ݐ" <= ch <= "ݿ" or "ﭐ" <= ch <= "ﻼ" for ch in text)


def default_user():
    try:
        u = open(LAST_USER, encoding="utf-8").read().strip()
        if u:
            pwd.getpwnam(u)
            return u
    except (OSError, KeyError):
        pass
    users = sorted((p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000),
                   key=lambda p: p.pw_uid)
    return users[0].pw_name if users else ""


if os.environ.get("ZOOL_GREETER_SELFTEST"):
    u, _, p = os.environ["ZOOL_GREETER_SELFTEST"].partition(":")
    print(Greetd().login(u, p), has_arabic(p)); sys.exit(0)

import gi                                                      # noqa: E402
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GLib, Gtk                      # noqa: E402

# ── تصميم الألوان ─────────────────────────────────────────────────────────────
# لوحة يمين فاتحة دافئة، نصوص بنية، لكنة ترابية
_PANEL  = "#f2ece3"      # كريمي دافئ
_TEXT   = "#2c1a0e"      # بني غامق
_MUTED  = "#7a6050"      # بني متوسط (نصوص ثانوية)
_ACCENT = "#7a3f28"      # ترابي نحاسي (أزرار، تركيز)
_FIELD  = "#ffffff"      # حقول بيضاء
_BORDER = "rgba(44,26,14,0.18)"
_BG_CSS = f'background-image: url("{BG}");' if BG and os.path.exists(BG) else ""

AR_WARN = "أنت تكتب بالعربية — اضغط Alt+Shift للتحويل إلى الإنجليزية"

CSS = f"""
* {{
    font-family: "IBM Plex Sans Arabic", "Noto Sans Arabic",
                 "JetBrainsMono Nerd Font", "Noto Sans", sans-serif;
    font-size: 15px;
    border-radius: 0;
    border: none;
    box-shadow: none;
    text-shadow: none;
    -gtk-icon-shadow: none;
}}

/* النافذة كاملة: خلفية داكنة (تظهر لثانية حتى تُحمَّل الصورة) */
window {{ background-color: #1a1410; }}

/* يسار: الصورة تملأ المساحة كاملة */
#bg-side {{
    {_BG_CSS}
    background-size: cover;
    background-position: center;
}}

/* يمين: اللوحة */
#panel {{
    background-color: {_PANEL};
    min-width: 420px;
    max-width: 420px;
}}

/* الترحيب */
#greeting {{
    color: {_TEXT};
    font-family: "Reem Kufi", "IBM Plex Sans Arabic", "Noto Sans Arabic", sans-serif;
    font-size: 20px;
    font-weight: bold;
}}

/* الساعة */
#clock {{
    color: {_TEXT};
    font-family: "JetBrainsMono Nerd Font", "IBM Plex Sans Arabic", sans-serif;
    font-size: 54px;
    font-weight: bold;
    letter-spacing: -0.02em;
}}

/* التاريخ */
#date-label {{
    color: {_MUTED};
    font-family: "IBM Plex Sans Arabic", "Noto Sans Arabic", sans-serif;
    font-size: 13px;
}}

/* فاصل */
separator {{ background-color: {_BORDER}; min-height: 1px; margin: 8px 0; }}

/* حقول الإدخال */
entry {{
    background-color: {_FIELD};
    color: {_TEXT};
    caret-color: {_ACCENT};
    border: 1.5px solid {_BORDER};
    border-radius: 10px;
    padding: 11px 16px;
    font-size: 15px;
    min-height: 0;
}}
entry:focus {{ border-color: {_ACCENT}; }}
entry image {{ color: {_MUTED}; margin: 0 4px; }}

/* خانة "كشف كلمة المرور" */
checkbutton {{
    color: {_MUTED};
    font-size: 13px;
    spacing: 8px;
}}
checkbutton check {{
    background-color: {_FIELD};
    border: 1.5px solid {_BORDER};
    border-radius: 5px;
    min-width: 18px;
    min-height: 18px;
}}
checkbutton:checked check {{
    background-color: {_ACCENT};
    border-color: {_ACCENT};
    color: white;
}}

/* رسالة الخطأ */
#error {{
    color: #b03020;
    font-size: 13px;
    font-weight: 600;
}}

/* زر تسجيل الدخول */
#btn-login {{
    background-color: {_ACCENT};
    color: white;
    border-radius: 10px;
