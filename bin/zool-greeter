#!/usr/bin/env python3
"""شاشة دخول زول — اسم المستخدم + كلمة المرور (تعمل فوق greetd داخل cage).

تتحدث مع greetd عبر المقبس $GREETD_SOCK ثم تبدأ جلسة Hyprland (zool-session).
"""
import json
import os
import pwd
import socket
import struct
import subprocess
import sys

SESSION_CMD = ["/usr/local/bin/zool-session"]
SESSION_ENV = ["XDG_SESSION_TYPE=wayland", "XDG_CURRENT_DESKTOP=Hyprland"]
LAST_USER = "/var/lib/zool-greeter/last-user"
BG = "/usr/share/zool/themes/turath/backgrounds/1-meroe-pyramids.jpg"
LOGO = "/usr/share/zool/logo/zool-logo-128.png"


class Greetd:
    """بروتوكول greetd: طول الرسالة (u32 بترتيب بايتات الجهاز) ثم JSON."""

    def __init__(self, path=None):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.connect(path or os.environ["GREETD_SOCK"])

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            part = self.s.recv(n - len(buf))
            if not part:
                raise ConnectionError("greetd closed the connection")
            buf += part
        return buf

    def call(self, **msg):
        data = json.dumps(msg).encode()
        self.s.sendall(struct.pack("=I", len(data)) + data)
        (n,) = struct.unpack("=I", self._read(4))
        return json.loads(self._read(n).decode())

    def login(self, user, password):
        """يعيد (True, "") عند النجاح، أو (False, سبب)."""
        print(f"[zool-greeter] create_session username={user!r}", file=sys.stderr)
        r = self.call(type="create_session", username=user)
        for _ in range(8):
            if r.get("type") != "auth_message":
                break
            kind = r.get("auth_message_type")
            r = self.call(type="post_auth_message_response",
                          response=password if kind in ("secret", "visible") else None)
        if r.get("type") == "success":
            r = self.call(type="start_session", cmd=SESSION_CMD, env=SESSION_ENV)
            if r.get("type") == "success":
                return True, ""
            return False, r.get("description", "start_session failed")
        print(f"[zool-greeter] auth failed for {user!r}: {r!r}", file=sys.stderr)
        try:
            self.call(type="cancel_session")
        except (OSError, ValueError):
            pass
        return False, "auth" if r.get("error_type") == "auth_error" else r.get("description", "error")


def has_arabic(text):
    return any("؀" <= ch <= "ۿ" or "ݐ" <= ch <= "ݿ" or "ﭐ" <= ch <= "ﻼ" for ch in text)


def default_user():
    try:
        u = open(LAST_USER, encoding="utf-8").read().strip()
        if u:
            pwd.getpwnam(u)
            return u
    except (OSError, KeyError):
        pass
    users = sorted((p for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000), key=lambda p: p.pw_uid)
    return users[0].pw_name if users else ""


if os.environ.get("ZOOL_GREETER_SELFTEST"):                    # اختبار البروتوكول بلا واجهة
    u, _, p = os.environ["ZOOL_GREETER_SELFTEST"].partition(":")
    print(Greetd().login(u, p), has_arabic(p)); sys.exit(0)

import gi                                                      # noqa: E402
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")        # صراحة: بعض الأنظمة تحمّل GTK4 (Gdk 4.0) أولاً من مكتبة
gi.require_version("GdkPixbuf", "2.0")  # أخرى في نفس العملية، فيتعارض مع Gtk 3.0 ويُسقِط الشاشة فوراً
from gi.repository import Gdk, GLib, Gtk                       # noqa: E402

CSS = """
window { background-color: #10181c; %s background-size: cover; background-position: center; }
* { font-family: "IBM Plex Sans Arabic", "Noto Sans Arabic", sans-serif; }
#card { background-color: rgba(16, 24, 28, 0.82); border: 1px solid rgba(232, 176, 74, 0.35); border-radius: 22px; padding: 30px 38px; }
#clock { color: #f3e6cc; font-size: 46px; font-weight: 500; }
#hint { color: #b9a98a; font-size: 13px; }
#error { color: #e8896a; font-size: 14px; font-weight: 600; }
entry { background-color: #172229; color: #f3e6cc; caret-color: #e8b04a; border: 2px solid rgba(185, 169, 138, 0.45);
        border-radius: 24px; padding: 10px 18px; font-size: 16px; min-height: 28px; box-shadow: none; }
entry:focus { border-color: #e8b04a; }
entry image { color: #e8b04a; margin: 0 4px; }
button { background-image: none; background-color: #e8b04a; color: #10181c; border: none; border-radius: 24px;
         padding: 10px 18px; font-size: 16px; font-weight: 700; box-shadow: none; text-shadow: none; }
button:hover { background-color: #f0c067; }
button:disabled { background-color: #5a5346; color: #10181c; }
button.flat { background-color: transparent; color: #b9a98a; font-size: 13px; font-weight: 500; padding: 6px 14px; }
button.flat:hover { color: #f3e6cc; background-color: rgba(243, 230, 204, 0.08); }
""" % ('background-image: url("%s");' % BG if os.path.exists(BG) else "")

AR_WARN = "أنت تكتب بالعربية — اضغط Alt+Shift للتحويل إلى الإنجليزية\nArabic keyboard is active — press Alt+Shift"


class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Zool OS")
        self.set_default_size(1024, 700)
        self.fullscreen()
        p = Gtk.CssProvider(); p.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, name="card")
        card.set_halign(Gtk.Align.CENTER); card.set_valign(Gtk.Align.CENTER); card.set_size_request(360, -1)
        root.pack_start(card, True, True, 0)

        if os.path.exists(LOGO):
            try:
                from gi.repository import GdkPixbuf
                card.pack_start(Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(LOGO, 84, 84)), False, False, 0)
            except GLib.Error:
                pass
        self.clock = Gtk.Label(name="clock"); card.pack_start(self.clock, False, False, 0)

        self.user = Gtk.Entry(); self.user.set_placeholder_text("اسم المستخدم · Username")
        self.user.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "avatar-default-symbolic")
        self.user.set_text(default_user())
        self.pw = Gtk.Entry(); self.pw.set_placeholder_text("كلمة المرور · Password")
        self.pw.set_visibility(False); self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "dialog-password-symbolic")
        for e in (self.user, self.pw):
            e.set_direction(Gtk.TextDirection.LTR); e.set_alignment(0.0)
            e.connect("changed", self.on_changed)
            card.pack_start(e, False, False, 0)
        self.user.connect("activate", lambda *_: self.pw.grab_focus())
        self.pw.connect("activate", self.on_login)

        self.error = Gtk.Label(name="error"); self.error.set_line_wrap(True); self.error.set_justify(Gtk.Justification.CENTER)
        self.error.set_max_width_chars(36); card.pack_start(self.error, False, False, 0)
        self.btn = Gtk.Button(label="دخول · Log in"); self.btn.connect("clicked", self.on_login)
        card.pack_start(self.btn, False, False, 0)
        hint = Gtk.Label(label="Alt+Shift لتبديل لغة لوحة المفاتيح", name="hint"); card.pack_start(hint, False, False, 0)

        bar = Gtk.Box(spacing=6); bar.set_halign(Gtk.Align.CENTER); bar.set_margin_bottom(18)
        for text, cmd in (("إعادة التشغيل · Restart", "reboot"), ("إيقاف التشغيل · Shut down", "poweroff")):
            b = Gtk.Button(label=text); b.get_style_context().add_class("flat")
            b.connect("clicked", lambda _b, c=cmd: subprocess.Popen(["systemctl", c]))
            bar.pack_start(b, False, False, 0)
        root.pack_end(bar, False, False, 0)

        self.tick(); GLib.timeout_add_seconds(20, self.tick)
        self.show_all()
        (self.pw if self.user.get_text() else self.user).grab_focus()

    def tick(self):
        self.clock.set_text(GLib.DateTime.new_now_local().format("%H:%M"))
        return True

    def on_changed(self, *_):
        arabic = has_arabic(self.user.get_text() + self.pw.get_text())
        self.error.set_text(AR_WARN if arabic else "")
        self.btn.set_sensitive(not arabic)

    def on_login(self, *_):
        user, pw = self.user.get_text().strip(), self.pw.get_text()
        if has_arabic(user + pw):
            self.error.set_text(AR_WARN); return
        if not user:
            self.error.set_text("اكتب اسم المستخدم · Enter your username"); self.user.grab_focus(); return
        self.btn.set_sensitive(False)
        self.error.set_text("")
        GLib.idle_add(self.do_login, user, pw)

    def do_login(self, user, pw):
        try:
            ok, why = Greetd().login(user, pw)
        except (OSError, KeyError, ValueError) as exc:
            ok, why = False, str(exc)
        if ok:
            try:
                with open(LAST_USER, "w", encoding="utf-8") as f:
                    f.write(user)
            except OSError:
                pass
            Gtk.main_quit()
            return False
        self.error.set_text("اسم المستخدم أو كلمة المرور غير صحيحة\nWrong username or password" if why == "auth" else why)
        self.pw.set_text(""); self.btn.set_sensitive(True); self.pw.grab_focus()
        return False


if __name__ == "__main__":
    Greeter()
    Gtk.main()
