    font-size: 16px;
    font-weight: bold;
    min-height: 0;
}}
#btn-login:hover   {{ background-color: #8f4a30; }}
#btn-login:disabled {{ background-color: rgba(122,63,40,0.35); color: white; }}

/* شريط الطاقة السفلي */
#power-col button {{
    background-color: transparent;
    color: {_MUTED};
    border: 1.5px solid {_BORDER};
    border-radius: 50%;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 18px;
}}
#power-col button:hover {{
    color: {_ACCENT};
    border-color: {_ACCENT};
    background-color: rgba(122,63,40,0.08);
}}
#power-label {{
    color: {_MUTED};
    font-size: 11px;
}}
"""


# ── واجهة المستخدم ────────────────────────────────────────────────────────────

class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Zool OS")
        self.fullscreen()

        # CSS
        p = Gtk.CssProvider()
        p.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # ── تقسيم أفقي: يسار صورة + يمين لوحة ──
        split = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(split)

        bg_side = Gtk.Box(name="bg-side")
        split.pack_start(bg_side, True, True, 0)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, name="panel")
        split.pack_end(panel, False, False, 0)

        # ── محتوى اللوحة (يتمركز عمودياً) ──
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_halign(Gtk.Align.FILL)
        content.set_valign(Gtk.Align.CENTER)
        content.set_margin_start(44)
        content.set_margin_end(44)
        panel.pack_start(content, True, True, 0)

        # الترحيب — "زول" اسم ثابت (هوية النظام)
        user0 = default_user()
        greeting = Gtk.Label(label="مرحباً بك يا زول", name="greeting")
        greeting.set_halign(Gtk.Align.END)
        content.pack_start(greeting, False, False, 0)

        # الساعة
        self.clock_lbl = Gtk.Label(name="clock")
        self.clock_lbl.set_halign(Gtk.Align.END)
        content.pack_start(self.clock_lbl, False, False, 0)

        # التاريخ
        self.date_lbl = Gtk.Label(name="date-label")
        self.date_lbl.set_halign(Gtk.Align.END)
        content.pack_start(self.date_lbl, False, False, 0)

        # فاصل
        content.pack_start(Gtk.Separator(), False, False, 4)

        # حقل اسم المستخدم
        self.user = Gtk.Entry()
        self.user.set_placeholder_text("اسم المستخدم · Username")
        self.user.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "avatar-default-symbolic")
        self.user.set_text(user0)
        self.user.set_direction(Gtk.TextDirection.LTR)
        self.user.set_alignment(0.0)
        content.pack_start(self.user, False, False, 0)

        # حقل كلمة المرور
        self.pw = Gtk.Entry()
        self.pw.set_placeholder_text("كلمة المرور · Password")
        self.pw.set_visibility(False)
        self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "dialog-password-symbolic")
        self.pw.set_direction(Gtk.TextDirection.LTR)
        self.pw.set_alignment(0.0)
        content.pack_start(self.pw, False, False, 0)

        # خانة كشف كلمة المرور
        show_pw = Gtk.CheckButton(label="كشف كلمة المرور · Show password")
        show_pw.set_halign(Gtk.Align.END)
        show_pw.connect("toggled", lambda b: self.pw.set_visibility(b.get_active()))
        content.pack_start(show_pw, False, False, 0)

        # رسالة الخطأ / التحذير
        self.error = Gtk.Label(name="error")
        self.error.set_halign(Gtk.Align.CENTER)
        self.error.set_line_wrap(True)
        self.error.set_justify(Gtk.Justification.CENTER)
        self.error.set_max_width_chars(32)
        content.pack_start(self.error, False, False, 0)

        # زر تسجيل الدخول
        self.btn = Gtk.Button(label="تسجيل الدخول  ›")
        self.btn.set_name("btn-login")
        self.btn.connect("clicked", self.on_login)
        content.pack_start(self.btn, False, False, 4)

        # ── شريط الطاقة في أسفل اللوحة ──
        power_bar = Gtk.Box(spacing=28)
        power_bar.set_halign(Gtk.Align.CENTER)
        power_bar.set_margin_bottom(32)
        power_bar.set_margin_top(8)

        for icon, label, cmd in [
            ("⏻", "إطفاء",        ["systemctl", "poweroff"]),
            ("↺", "إعادة الإقلاع", ["systemctl", "reboot"]),
            ("⏾", "تعليق",        ["systemctl", "suspend"]),
        ]:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5, name="power-col")
            col.set_halign(Gtk.Align.CENTER)
            b = Gtk.Button(label=icon)
            b.connect("clicked", lambda _, c=cmd: subprocess.Popen(c))
            lbl = Gtk.Label(label=label, name="power-label")
            col.pack_start(b, False, False, 0)
            col.pack_start(lbl, False, False, 0)
            power_bar.pack_start(col, False, False, 0)

        panel.pack_end(power_bar, False, False, 0)

        # ── إشارات ──
        self.user.connect("changed", self.on_changed)
        self.pw.connect("changed", self.on_changed)
        self.user.connect("activate", lambda *_: self.pw.grab_focus())
        self.pw.connect("activate", self.on_login)

        self.tick()
        GLib.timeout_add_seconds(20, self.tick)
        self.show_all()
        (self.pw if self.user.get_text() else self.user).grab_focus()

    def tick(self):
        now = GLib.DateTime.new_now_local()
        self.clock_lbl.set_text(now.format("%H:%M"))
        self.date_lbl.set_text(now.format("%A، %d %B %Y"))
        return True

    def on_changed(self, *_):
        arabic = has_arabic(self.user.get_text() + self.pw.get_text())
        self.error.set_text(AR_WARN if arabic else "")
        self.btn.set_sensitive(not arabic)

    def on_login(self, *_):
        user, pw = self.user.get_text().strip(), self.pw.get_text()
        if has_arabic(user + pw):
            self.error.set_text(AR_WARN); return
        if not user:
            self.error.set_text("اكتب اسم المستخدم · Enter your username")
            self.user.grab_focus(); return
        self.btn.set_sensitive(False)
        self.error.set_text("")
        GLib.idle_add(self.do_login, user, pw)

    def do_login(self, user, pw):
        try:
            ok, why = Greetd().login(user, pw)
        except (OSError, KeyError, ValueError) as exc:
            ok, why = False, str(exc)
        if ok:
            try:
                os.makedirs(os.path.dirname(LAST_USER), exist_ok=True)
                with open(LAST_USER, "w", encoding="utf-8") as f:
                    f.write(user)
            except OSError:
                pass
            Gtk.main_quit()
            return False
        self.error.set_text(
            "اسم المستخدم أو كلمة المرور غير صحيحة\nWrong username or password"
            if why == "auth" else why)
        self.pw.set_text(""); self.btn.set_sensitive(True); self.pw.grab_focus()
        return False


if __name__ == "__main__":
    Greeter()
    Gtk.main()
