#!/bin/bash
# ═══════════════════════════════════════════════
#  zool-store — متجر برامج زول
#    • برامج مختارة (من مستودعات Arch الرسمية)
#    • بحث في المستودعات الرسمية
#    • بحث في AUR (عبر paru — يُثبَّت عند أول استعمال)
#    • إزالة برنامج
# ═══════════════════════════════════════════════
T="متجر زول"
LOGO=/usr/share/zool/logo/zool-logo-128.png
Z() { zenity --title="$T" --window-icon="$LOGO" "$@" 2>/dev/null; }

# ينفّذ أمراً في طرفية ليظهر التقدّم وتُكتب كلمة المرور
term() {  # term <عنوان> <أمر...>
    local title="$1"; shift
    kitty --title "$title" -e bash -c '
        "$@"; rc=$?
        echo
        if [ $rc = 0 ]; then echo "✓ تمّ"; else echo "✗ لم تكتمل العملية (رمز $rc) — تأكد من الاتصال بالإنترنت"; fi
        read -r -p "Enter للإغلاق " _' _ "$@"
}

need_net() {
    curl -fsS -m 6 -o /dev/null https://archlinux.org 2>/dev/null && return 0
    Z --error --width=380 --text="لا يوجد اتصال بالإنترنت.\nاتصل بالشبكة ثم أعد المحاولة."; return 1
}

# ── البرامج المختارة:  الفئة | الاسم | الوصف | الحزم ──
CURATED='مكتب|LibreOffice|حزمة مكتبية كاملة بواجهة عربية|libreoffice-fresh libreoffice-fresh-ar
مكتب|Thunderbird|بريد إلكتروني|thunderbird thunderbird-i18n-ar
مكتب|Okular|قارئ PDF وكتب متقدم|okular
إنترنت|Chromium|متصفح كروميوم|chromium
إنترنت|Telegram|تيليجرام|telegram-desktop
إنترنت|qBittorrent|تحميل التورنت|qbittorrent
وسائط|VLC|مشغّل وسائط شامل|vlc
وسائط|OBS Studio|تسجيل الشاشة والبث|obs-studio
وسائط|Audacity|تحرير الصوت|audacity
وسائط|Kdenlive|مونتاج الفيديو|kdenlive
رسم|GIMP|تحرير الصور|gimp
رسم|Inkscape|رسم متجهي|inkscape
رسم|Krita|رسم رقمي|krita
برمجة|VS Code (OSS)|محرر شيفرة|code
برمجة|Python + pip|بايثون وأدواته|python-pip python-virtualenv
برمجة|Node.js|جافاسكربت|nodejs npm
برمجة|Docker|حاويات|docker docker-compose
أدوات|Timeshift|نقاط استرجاع للنظام|timeshift
أدوات|طابعات (CUPS)|دعم الطباعة|cups system-config-printer
تعليم|GCompris|ألعاب تعليمية للأطفال|gcompris-qt
تعليم|Stellarium|القبة السماوية|stellarium'

curated() {
    local args=() cat name desc pkgs sel
    while IFS='|' read -r cat name desc pkgs; do
        if pacman -Qq ${pkgs%% *} >/dev/null 2>&1; then desc="$desc  ✓ مثبّت"; fi
        args+=(FALSE "$name" "$cat" "$desc")
    done <<< "$CURATED"
    sel=$(Z --list --checklist --width=720 --height=620 --separator='|' \
            --text="اختر ما تريد تثبيته ثم اضغط «تثبيت»:" \
            --column="" --column="البرنامج" --column="الفئة" --column="الوصف" \
            --ok-label="تثبيت" --cancel-label="رجوع" "${args[@]}") || return 0
    [ -n "$sel" ] || return 0
    local all="" n
    IFS='|' read -ra picks <<< "$sel"
    for n in "${picks[@]}"; do
        all+=" $(printf '%s\n' "$CURATED" | awk -F'|' -v n="$n" '$2==n{print $4}')"
    done
    need_net || return 0
    # shellcheck disable=SC2086
    term "تثبيت البرامج" sudo pacman -Sy --needed $all
}

search_repo() {
    local q rows=() sel
    q=$(Z --entry --width=420 --text="اكتب اسم البرنامج (بالإنجليزية):") || return 0
    [ -n "$q" ] || return 0
    while IFS=$'\t' read -r name desc; do rows+=("$name" "$desc"); done < <(
        pacman -Ss -- "$q" 2>/dev/null | awk 'NR%2==1{split($1,a,"/"); n=a[2]; inst=($0 ~ /\[installed/)?"  ✓":""} NR%2==0{sub(/^ +/,""); print n "\t" $0 inst}' | head -150)
    [ "${#rows[@]}" -gt 0 ] || { Z --info --width=360 --text="لا نتائج لـ «$q».\nجرّب «بحث في AUR»."; return 0; }
    sel=$(Z --list --width=760 --height=560 --text="نتائج «$q» في المستودعات الرسمية:" \
            --column="الحزمة" --column="الوصف" --ok-label="تثبيت" --cancel-label="رجوع" "${rows[@]}") || return 0
    [ -n "$sel" ] && need_net && term "تثبيت $sel" sudo pacman -Sy --needed "$sel"
}

setup_aur() {
    command -v paru >/dev/null && return 0
    Z --question --width=480 --ok-label="ثبّت paru" --cancel-label="إلغاء" --text="AUR مستودع يرفع إليه المستخدمون أنفسهم آلاف البرامج غير الموجودة في المستودعات الرسمية.\n\n⚠ حزمه غير مراجَعة من Arch — ثبّت منه ما تثق بمصدره فقط.\n\nللوصول إليه يلزم تثبيت المساعد <b>paru</b> (مرة واحدة). هل تتابع؟" || return 1
    need_net || return 1
    term "تثبيت paru" bash -c '
        set -e
        sudo pacman -Sy --needed base-devel git
        d=$(mktemp -d); cd "$d"
        git clone --depth 1 https://aur.archlinux.org/paru-bin.git
        cd paru-bin && makepkg -si --noconfirm'
    command -v paru >/dev/null || { Z --error --width=360 --text="لم يكتمل تثبيت paru."; return 1; }
}

search_aur() {
    setup_aur || return 0
    local q rows=() sel
    q=$(Z --entry --width=420 --text="اكتب اسم البرنامج للبحث في AUR:") || return 0
    [ "${#q}" -ge 2 ] || return 0
    need_net || return 0
    while IFS=$'\t' read -r name votes desc; do rows+=("$name" "$votes" "$desc"); done < <(
        curl -fsS -m 20 -G --data-urlencode "arg=$q" "https://aur.archlinux.org/rpc/v5/search" 2>/dev/null \
        | jq -r '.results | sort_by(-.NumVotes) | .[:120][] | [.Name, (.NumVotes|tostring), (.Description // "")] | @tsv' 2>/dev/null)
    [ "${#rows[@]}" -gt 0 ] || { Z --info --width=360 --text="لا نتائج لـ «$q» في AUR."; return 0; }
    sel=$(Z --list --width=800 --height=560 --text="نتائج «$q» في AUR (الأكثر تصويتاً أولاً):" \
            --column="الحزمة" --column="الأصوات" --column="الوصف" --ok-label="تثبيت" --cancel-label="رجوع" "${rows[@]}") || return 0
    [ -n "$sel" ] && term "تثبيت $sel من AUR" paru -S "$sel"
}

remove_pkg() {
    local rows=() sel
    while IFS=$'\t' read -r name desc; do rows+=("$name" "$desc"); done < <(
        pacman -Qei 2>/dev/null | awk -F': ' '/^Name/{n=$2} /^Description/{print n "\t" $2}')
    sel=$(Z --list --width=760 --height=600 --text="البرامج التي ثبّتَّها (اختر واحداً لإزالته):" \
            --column="الحزمة" --column="الوصف" --ok-label="إزالة" --cancel-label="رجوع" "${rows[@]}") || return 0
    [ -n "$sel" ] && term "إزالة $sel" sudo pacman -Rns "$sel"
}

[ "${1:-}" = "--setup-aur" ] && { setup_aur; exit $?; }
while :; do
    c=$(Z --list --width=520 --height=380 --hide-header --text="<b>متجر زول</b> — ماذا تريد؟" --column="" \
          --ok-label="فتح" --cancel-label="إغلاق" \
          "برامج مختارة (موصى بها)" "بحث في مستودعات Arch" "بحث في AUR (paru)" "إزالة برنامج" "تحديث النظام") || exit 0
    case "$c" in
        برامج*)        curated ;;
        "بحث في مست"*) search_repo ;;
        "بحث في AUR"*) search_aur ;;
        إزالة*)        remove_pkg ;;
        تحديث*)        kitty --title "تحديث زول" -e zool-update ;;
    esac
done
