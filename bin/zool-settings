#!/bin/sh
# zool-settings — مركز الإعدادات: كل ما يحتاجه المستخدم في مكان واحد
LOGO=/usr/share/zool/logo/zool-logo-128.png
choice=$(printf '%s\n' \
  "الشبكة والواي فاي" \
  "البلوتوث" \
  "الصوت" \
  "الثيم والألوان" \
  "الخلفية" \
  "المؤثرات (خفيف / كامل)" \
  "مدينة أوقات الصلاة" \
  "المنطقة الزمنية" \
  "كلمة المرور" \
  "متجر البرامج" \
  "تحديث النظام" \
  "الاختصارات" \
  "معلومات النظام" \
  | wofi --dmenu --prompt "الإعدادات" --width 460 --height 560 --columns 1) || exit 0

case "$choice" in
    الشبكة*)   kitty --title "الشبكة" -e nmtui ;;
    البلوتوث*) blueman-manager ;;
    الصوت*)    pavucontrol ;;
    الثيم*)    zool-theme ;;
    الخلفية*)  zool-wallpaper pick ;;
    المؤثرات*) zool-effects toggle ;;
    مدينة*)    zool-prayer city ;;
    المنطقة*)
        tz=$(timedatectl list-timezones 2>/dev/null | wofi --dmenu --prompt "المنطقة الزمنية (مثل Africa/Khartoum)" --width 460 --height 520 --columns 1) || exit 0
        [ -n "$tz" ] && pkexec timedatectl set-timezone "$tz" && notify-send -i "$LOGO" "زول" "المنطقة الزمنية: $tz" ;;
    كلمة*)     kitty --title "تغيير كلمة المرور" -e sh -c 'passwd; echo; read -r -p "Enter للإغلاق " _' ;;
    متجر*)     zool-store ;;
    تحديث*)    kitty --title "تحديث زول" -e zool-update ;;
    الاختصارات*) zool-keys ;;
    معلومات*)  kitty --title "معلومات النظام" -e sh -c 'fastfetch; echo; echo "نسخة زول: $(zool-update version | cut -c1-8)"; echo; read -r -p "Enter للإغلاق " _' ;;
esac
