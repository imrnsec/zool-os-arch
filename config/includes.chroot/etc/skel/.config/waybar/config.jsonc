{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "hyprland/language", "cpu", "memory", "pulseaudio", "bluetooth", "network", "battery", "custom/power"],

    "custom/launcher": {
        "format": " snlnOS ",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 5 }
    },

    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "hyprland/language": {
        "format": " {short}",
        "on-click": "hyprctl switchxkblayout all next"
    },

    "cpu": { "format": " {usage}%", "interval": 3 },
    "memory": { "format": " {percentage}%", "interval": 5 },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", ""] },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "on-click": "blueman-manager",
        "tooltip-format": "{status}"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": " offline",
        "tooltip-format": "{essid} {ifname}",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 25, "critical": 12 }
    },

    "tray": { "spacing": 10 },

    "custom/power": {
        "format": "",
        "on-click": "snln-power",
        "tooltip": false
    }
}
