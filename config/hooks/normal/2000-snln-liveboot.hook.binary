#!/bin/sh
# ═══════════════════════════════════════════════
#  Hook محمّلات الإقلاع الحية (binary)
#  يخصص قائمة الإقلاع نفسها (GRUB UEFI + syslinux BIOS)
#
#  ملاحظة مهمة: هذا الهوك يعدّل الملفات مباشرة داخل مجلد
#  binary/ (المرحلة النهائية التي تُحوَّل حرفياً إلى الـ ISO)
#  بدل قوالب config/bootloaders الداخلية للأداة، لأن أسماء
#  ومسارات تلك القوالب تختلف باختلاف إصدار/نسخة live-build
#  (Debian الرسمية مقابل نسخة Kali). التعديل على binary/
#  مباشرة يعمل بغض النظر عن تلك الاختلافات لأنه يحدث بعد أن
#  تنتهي live-build من توليد قائمة الإقلاع الافتراضية.
# ═══════════════════════════════════════════════
set -e

find_root() {
    dir="$(pwd)"
    while [ "$dir" != "/" ]; do
        if [ -d "$dir/config/hooks/normal" ] && [ -d "$dir/config/includes.chroot" ]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

ROOT="$(find_root)" || {
    echo "[snln-liveboot] خطأ: تعذّر إيجاد جذر مشروع live-build." >&2
    exit 1
}
cd "$ROOT"
echo "[snln-liveboot] جذر المشروع: $ROOT"

if [ ! -d binary ]; then
    echo "[snln-liveboot] خطأ: مجلد binary/ غير موجود بعد — يجب أن يعمل هذا الهوك بعد مرحلة binary_grub/binary_syslinux." >&2
    exit 1
fi

THEME_SRC="chroot/boot/grub/themes/snln"
SPLASH_SRC="chroot/usr/share/snln/splash.png"

# ── 1) ثيم GRUB (UEFI) ──
echo "[snln-liveboot] البحث عن ملفات grub.cfg داخل binary/..."
GRUB_CFGS="$(find binary -type f -name 'grub.cfg' 2>/dev/null)"
if [ -n "$GRUB_CFGS" ] && [ -d "$THEME_SRC" ]; then
    for cfg in $GRUB_CFGS; do
        gdir="$(dirname "$cfg")"
        mkdir -p "$gdir/themes"
        cp -r "$THEME_SRC" "$gdir/themes/"
        # إزالة أي "set theme=" سابق ثم إضافة تعييننا في أول الملف
        sed -i '/^set theme=/d' "$cfg"
        sed -i '1i set theme=/boot/grub/themes/snln/theme.txt' "$cfg"
        # مهم: config.cfg يستدعي theme.cfg الذي يعيد ضبط الثيم إلى
        # live-theme الافتراضي (الشعار الأصفر) إن وُجد splash.png
        # الافتراضي، فيُلغي تعييننا أعلاه. نصلح theme.cfg مباشرة كي
        # يشير لثيمنا بدل ثيم Debian الافتراضي.
        if [ -f "$gdir/theme.cfg" ]; then
            sed -i 's|/boot/grub/live-theme/theme.txt|/boot/grub/themes/snln/theme.txt|' "$gdir/theme.cfg"
            echo "[snln-liveboot] تم تصحيح $gdir/theme.cfg ليستخدم ثيمنا بدل الافتراضي."
        fi
        # حذف أسطر echo الافتراضية (نصوص "Debian GNU/Linux..." إلخ)
        sed -i '/^echo /d' "$cfg"
        echo "[snln-liveboot] تم تطبيق ثيم GRUB على: $cfg"
    done
else
    echo "[snln-liveboot] تحذير: لم يُعثر على grub.cfg أو مجلد الثيم $THEME_SRC — تم تخطي ثيم GRUB." >&2
fi

# ── 2) خلفية syslinux/isolinux (BIOS) ──
echo "[snln-liveboot] البحث عن ملفات قوائم syslinux/isolinux داخل binary/..."
if [ -f "$SPLASH_SRC" ]; then
    MENU_DIRS="$(find binary -maxdepth 2 -type d \( -iname 'isolinux' -o -iname 'syslinux' \) 2>/dev/null)"
    for mdir in $MENU_DIRS; do
        cp "$SPLASH_SRC" "$mdir/splash.png"
        # عدّل كل ملفات .cfg التي تشير إلى خلفية، أو أضف السطر لأول ملف .cfg رئيسي إن لم يوجد
        found_cfg=0
        for cfg in "$mdir"/*.cfg; do
            [ -f "$cfg" ] || continue
            if grep -qi 'menu background' "$cfg" 2>/dev/null; then
                sed -i 's|^\(\s*menu background\).*|\1 splash.png|I' "$cfg"
                found_cfg=1
            fi
        done
        if [ "$found_cfg" = "0" ]; then
            main_cfg="$mdir/isolinux.cfg"
            [ -f "$main_cfg" ] || main_cfg="$mdir/syslinux.cfg"
            if [ -f "$main_cfg" ]; then
                echo "menu background splash.png" >> "$main_cfg"
                found_cfg=1
            fi
        fi
        if [ "$found_cfg" = "1" ]; then
            echo "[snln-liveboot] تم تطبيق خلفية syslinux على: $mdir"
        else
            echo "[snln-liveboot] تحذير: لم يُعثر على ملف .cfg مناسب داخل $mdir لتطبيق الخلفية." >&2
        fi
    done
    if [ -z "$MENU_DIRS" ]; then
        echo "[snln-liveboot] تحذير: لم يُعثر على مجلد isolinux/syslinux داخل binary/." >&2
    fi
else
    echo "[snln-liveboot] تحذير: $SPLASH_SRC غير موجود — تم تخطي خلفية syslinux." >&2
fi

echo "[snln-liveboot] اكتمل ✔"
