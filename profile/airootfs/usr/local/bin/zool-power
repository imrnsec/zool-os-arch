#!/bin/sh
# قائمة الطاقة — SUPER+Escape
choice=$(printf '%s\n' \
  "Lock | قفل الشاشة" \
  "Logout | تسجيل الخروج" \
  "Suspend | سكون" \
  "Reboot | إعادة التشغيل" \
  "Shutdown | إيقاف التشغيل" \
  | wofi --dmenu --prompt "الطاقة" --width 420 --height 330 --columns 1)

case "$choice" in
    Lock*)     hyprlock ;;
    Logout*)   hyprctl dispatch exit ;;
    Suspend*)  systemctl suspend ;;
    Reboot*)   systemctl reboot ;;
    Shutdown*) systemctl poweroff ;;
esac
