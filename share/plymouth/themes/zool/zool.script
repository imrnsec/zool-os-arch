# ═══════════════════════════════════════════════
#  Zool OS — أنيميشن الإقلاع (Plymouth)
#  1) يظهر الشعار تدريجياً  2) تشرق الشمس خلف أهرامات مروي
#  3) تدور أشعة الشمس ببطء  4) يظهر الاسم  5) نقاط تحميل نابضة
# ═══════════════════════════════════════════════

Window.SetBackgroundTopColor(0.063, 0.094, 0.110);
Window.SetBackgroundBottomColor(0.035, 0.055, 0.067);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = screen_w / 2;

size = screen_h * 0.40;
if (size > 460) size = 460;
if (size < 200) size = 200;
cy = screen_h * 0.40;
sun_dy = (285 - 256) * size / 512;   # إزاحة مركز الشمس عن مركز اللوحة

fun clamp01(x) {
    if (x < 0) return 0;
    if (x > 1) return 1;
    return x;
}

fun ease(x) {
    local.v = clamp01(x);
    return 1 - (1 - v) * (1 - v) * (1 - v);
}

# ── طبقات الشعار (كلها بالإحداثيات نفسها) ──
sky_img = Image("layer-sky.png").Scale(size, size);
sky = Sprite(sky_img);
sky.SetPosition(cx - size / 2, cy - size / 2, 10);
sky.SetOpacity(0);

sun_img = Image("layer-sun.png").Scale(size, size);
sun = Sprite(sun_img);
sun.SetPosition(cx - size / 2, cy - size / 2, 20);
sun.SetOpacity(0);

rays_base = Image("layer-rays.png").Scale(size, size);
rays = Sprite(rays_base);
rays.SetOpacity(0);

land_img = Image("layer-land.png").Scale(size, size);
land = Sprite(land_img);
land.SetPosition(cx - size / 2, cy - size / 2, 30);
land.SetOpacity(0);

ring_img = Image("layer-ring.png").Scale(size, size);
ring = Sprite(ring_img);
ring.SetPosition(cx - size / 2, cy - size / 2, 40);
ring.SetOpacity(0);

# ── الاسم ──
wm_src = Image("wordmark.png");
wm_w = size * 1.3;
wm_h = wm_src.GetHeight() * wm_w / wm_src.GetWidth();
wm = Sprite(wm_src.Scale(wm_w, wm_h));
wm_y = cy + size / 2 + 6;
wm.SetPosition(cx - wm_w / 2, wm_y, 50);
wm.SetOpacity(0);

# ── نقاط التحميل ──
dot_img = Image("dot-on.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_img);
    dots[i].SetPosition(cx - 12 + (i - 1) * 34, wm_y + wm_h + 16, 50);
    dots[i].SetOpacity(0);
}

# ── رسالة نصية (مثل fsck أو أخطاء) ──
msg = Sprite();
fun message_cb(text) {
    local.img = Image.Text(text, 0.95, 0.9, 0.8, 1, "Sans 12");
    msg.SetImage(img);
    msg.SetPosition(screen_w / 2 - img.GetWidth() / 2, screen_h - 70, 60);
}
Plymouth.SetMessageFunction(message_cb);

t = 0;

fun refresh() {
    t = t + 1;
    p = t / 50;                        # الزمن بالثواني (الدالة تُستدعى 50 مرة/ثانية)

    a_in = ease(p / 0.7);
    sky.SetOpacity(a_in);
    land.SetOpacity(a_in);
    ring.SetOpacity(a_in);

    # شروق الشمس
    k = ease((p - 0.35) / 1.5);
    off = (1 - k) * 0.14 * size;
    sun.SetPosition(cx - size / 2, cy - size / 2 + off, 20);
    sun.SetOpacity(clamp01((p - 0.35) / 0.6));

    # أشعة تدور ببطء (تحديث كل إطارين لتخفيف الحمل)
    r_a = clamp01((p - 1.2) / 0.8);
    rays.SetOpacity(r_a);
    if (r_a > 0 && Math.Int(t / 2) * 2 == t) {
        angle = (p - 1.2) * 0.25;
        r_img = rays_base.Rotate(angle);
        rays.SetImage(r_img);
        rays.SetPosition(cx - r_img.GetWidth() / 2, cy + sun_dy - r_img.GetHeight() / 2 + off, 15);
    }

    # الاسم
    w_a = ease((p - 1.5) / 0.8);
    wm.SetOpacity(w_a);
    wm.SetY(wm_y + (1 - w_a) * 14);

    # نقاط نابضة
    d_a = ease((p - 2.0) / 0.5);
    for (i = 0; i < 3; i++) {
        pulse = 0.5 + 0.5 * Math.Sin(p * 5 - i * 0.9);
        dots[i].SetOpacity(d_a * (0.3 + 0.7 * pulse));
    }
}

Plymouth.SetRefreshFunction(refresh);
