# /usr/share/zool/default/zsh/rc — إعدادات zsh في Zool OS
# يُحدَّث هذا الملف مع zool-update. ضع تعديلاتك الخاصة في ~/.zshrc بعد سطر source.

# ── السجل ──
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP

# ── الإكمال التلقائي (Tab) ──
[ -d ~/.cache ] || mkdir -p ~/.cache
autoload -Uz compinit && compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'      # تجاهل حالة الأحرف
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── المفاتيح ──
bindkey -e
bindkey '^[[H' beginning-of-line;  bindkey '^[[F' end-of-line;  bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word;    bindkey '^[[1;5D' backward-word
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search; zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search; bindkey '^[[B' down-line-or-beginning-search   # ↑↓ يبحثان في السجل بما كتبته

# ── المحث: المستخدم@الجهاز المجلد (فرع git) — بألوان الثيم الحالي ──
autoload -Uz vcs_info
zstyle ':vcs_info:git:*' formats ' %F{magenta}(%b)%f'
precmd() { vcs_info }
setopt PROMPT_SUBST
PROMPT='%F{yellow}%n%f@%F{cyan}%m%f %F{blue}%~%f${vcs_info_msg_0_} %(?.%F{green}.%F{red})❯%f '

# ── ألوان ls: المجلدات أزرق، الملفات أبيض (الروابط سماوي، المكسور أحمر) ──
export LS_COLORS='rs=0:no=0:fi=0:di=1;34:ln=36:or=31:mi=31:ex=1:pi=0:so=0:bd=0:cd=0:su=0:sg=0:tw=1;34:ow=1;34:st=1;34'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── اختصارات ──
alias ls='ls --color=auto --group-directories-first'
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias update='zool-update'
alias install='zool-pkg-install'

# ── اقتراحات وتلوين الأوامر أثناء الكتابة ──
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
for f in /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
    [ -r "$f" ] && source "$f"
done
unset f

# ما تكتبه يظهر بالأزرق، والناتج بلون النص العادي (الأبيض)
zle_highlight=(default:fg=blue)
if (( ${+ZSH_HIGHLIGHT_STYLES} )); then
    ZSH_HIGHLIGHT_STYLES[default]='fg=blue'
    for k in command builtin alias suffix-alias global-alias function precommand reserved-word hashed-command arg0; do
        ZSH_HIGHLIGHT_STYLES[$k]='fg=blue,bold'
    done
    for k in path path_prefix autodirectory; do ZSH_HIGHLIGHT_STYLES[$k]='fg=blue,underline'; done
    for k in single-hyphen-option double-hyphen-option; do ZSH_HIGHLIGHT_STYLES[$k]='fg=cyan'; done
    for k in single-quoted-argument double-quoted-argument dollar-quoted-argument; do ZSH_HIGHLIGHT_STYLES[$k]='fg=yellow'; done
    ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red,bold'      # أمر غير موجود
    ZSH_HIGHLIGHT_STYLES[comment]='fg=8'
    unset k
fi
